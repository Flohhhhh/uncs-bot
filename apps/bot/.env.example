# Passive startup opens HTTP health endpoints only; no gateway, registration, or delivery.
NODE_ENV=development
NEST_ENV=development
PORT=4330
BOT_GATEWAY_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_DEVELOPMENT_GUILD_ID=
ADMIN_GUILD_ID=
API_ORIGIN=http://127.0.0.1:4321
BOT_TO_API_TOKEN=
API_TO_BOT_TOKEN=
# Discord delivery configuration: use the same isolated guild, role and channel IDs as the API.
# No DATABASE_URL, RCON password, or Patreon/OAuth credentials belong in this service.
# Optional welcome-template channel overrides for isolated guilds.
DISCORD_GENERAL_CHANNEL_ID=
DISCORD_SQUAD_UP_CHANNEL_ID=
DISCORD_LOBBY_CHANNEL_ID=
