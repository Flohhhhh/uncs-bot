# Local development only. This startup reads this app's .env, not the root .env.
NEST_ENV=development
PORT=4321
ADMIN_ENABLED=true

# Real auth/database with generated game data. Use live for actual configured game targets.
BACKEND_GAME_MODE=live
# standard (6 players), full-server (100 players), or pre-round
BACKEND_SAMPLE_SCENARIO=standard

# Paste your DEVELOPMENT PostgreSQL connection URL here.
DATABASE_URL=

# Browser-facing Next.js origin; use this hostname consistently.
ADMIN_ORIGIN=http://localhost:3000

# Discord OAuth app: register http://localhost:3000/admin/auth/callback.
ADMIN_DISCORD_CLIENT_ID=
ADMIN_DISCORD_CLIENT_SECRET=

# A unique development secret, at least 32 characters.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Existing bot's REST token is used only to read Discord membership/roles.
# This startup never connects a Discord gateway client.
DISCORD_BOT_TOKEN=
ADMIN_GUILD_ID=
ADMIN_OWNER_IDS=
ADMIN_ADMIN_ROLE_IDS=
ADMIN_MODERATOR_ROLE_IDS=
ADMIN_VIEWER_ROLE_IDS=

# Leave game endpoints unconfigured until you have deliberate development targets.
# Read endpoints requiring a game connection will report unavailable.
# WARDOGS_RCON_URL=
# WARDOGS_RCON_PASSWORD=
