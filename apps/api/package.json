{
  "name": "@uncs/api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch -r ts-node/register src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src tests --max-warnings 0",
    "verify": "npm run typecheck && npm run lint && npm test",
    "prebuild": "npm run build:packages --prefix ../..",
    "test": "jest --config jest.config.cjs --runInBand",
    "pretypecheck": "npm run build:packages --prefix ../..",
    "pretest": "npm run build:packages --prefix ../.."
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/schedule": "^6.0.1",
    "axios": "^1.13.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "discord.js": "^14.25.1",
    "drizzle-orm": "^0.45.2",
    "ms": "^2.1.3",
    "necord": "^6.11.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.1.13",
    "@uncs/contracts": "0.1.0",
    "@uncs/api-client": "0.1.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "tsx": "^4.21.0",
    "@types/pg": "^8.23.1",
    "@nestjs/testing": "^11.1.9",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2"
  }
}
