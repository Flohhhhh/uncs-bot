# Copy this file to `.env` and fill in the required values.

# These are your environment variables used to configure your application.
# On Railway, .env files are not used. Instead, you should set these variables in the Railway dashboard, under the "Variables" tab of your project.
# DO NOT commit your `.env` file to version control (git). Don't worry, this template is already set up to ignore it.
# This template validates the environment variables at startup. So if you misconfigure something, the bot will not start and an error will be shown in the logs.

### == Required == ###

DISCORD_BOT_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxx.xxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxx-xx"
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

### == Optional == ###
# You may need to uncomment some of these variables depending on your use case. You may also comment the ones you don't need.

# One of "development", "production" or "staging". If this is running on your local machine, you should set this to "development". Otherwise, set it to "production" or "staging" depending on your environment.
# Default: If not set, it will be "development" if NODE_ENV is "development", otherwise "production".
NEST_ENV="development"

# The port the application will run on.
PORT="3000"

# Optional Gramps staff dashboard. Enable after its reviewed database migration.
ADMIN_ENABLED=false
# ADMIN_ORIGIN=https://your-gramps-domain.example
# ADMIN_DISCORD_CLIENT_ID=your_discord_application_id
# ADMIN_DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
# ADMIN_SESSION_SECRET=generate_a_random_secret_of_at_least_32_characters
# ADMIN_GUILD_ID=82988952587337728
# ADMIN_OWNER_IDS=comma_separated_discord_user_ids
# ADMIN_ADMIN_ROLE_IDS=comma_separated_discord_role_ids
# ADMIN_MODERATOR_ROLE_IDS=comma_separated_discord_role_ids
# ADMIN_VIEWER_ROLE_IDS=comma_separated_discord_role_ids
# WARDOGS_RCON_URL=https://your_rcon_endpoint
# WARDOGS_RCON_PASSWORD=your_rcon_password

# Website whitelist requests. Requires the human-generated/reviewed application
# schema migration and Discord callback: ADMIN_ORIGIN/apply/auth/callback.
# Email is private application/access contact only, not a newsletter opt-in.
WHITELIST_APPLICATIONS_ENABLED=false
WHITELIST_APPLICATION_EMAIL_REQUIRED=true

# As discord caches application commands for up to an hour, it is recommended to specify a development guild when doing development. If you have multiple, separate them with commas (",").
# DO NOT SET THIS TO YOUR DEPLOYED PRODUCTION BOT!
# DISCORD_DEVELOPMENT_GUILD_ID=""

# Combat history and public leaderboard (requires reviewed schema and host feed integration).
WARDOGS_FEED_ENABLED=false
# WARDOGS_FEED_TOKEN=<separate-random-feed-only-secret-at-least-32-characters>

# Patreon supporter tracking. Enable only after the reviewed schema and creator webhook setup.
# Use the secret provided by Patreon for this webhook, never a bot/RCON/session secret.
# Endpoint: https://YOUR-GRAMPS-ORIGIN/supporters/webhooks/patreon
PATREON_ENABLED=false
# PATREON_CAMPAIGN_ID=<your-numeric-creator-campaign-id>
# PATREON_WEBHOOK_SECRET=<Patreon-webhook-signing-secret>
# Approved founder campaign: Sep 30 through Oct 14, 2026, Eastern time.
# Founder eligibility: a verified completed USD payment of at least $5 in that window.
PATREON_FOUNDER_START_AT=2026-09-30T00:00:00-04:00
PATREON_FOUNDER_END_AT=2026-10-15T00:00:00-04:00

# Optional single-instance Gramps community worker. Keep disabled for deployment
# until the reviewed admin schema exists and overlapping old announcements stop.
# Round messages follow an observed transition, not an authoritative match-end event.
SERVER_COMMUNITY_ENABLED=false
SERVER_COMMUNITY_WELCOME_ENABLED=false
SERVER_COMMUNITY_ROUND_ENABLED=false
SERVER_COMMUNITY_DISCORD_STATUS_ENABLED=false
SERVER_COMMUNITY_WELCOME_MESSAGE="Welcome to The UNCs! Squad up and enjoy the server."
SERVER_COMMUNITY_ROUND_MESSAGE="GG! Thanks for playing on The UNCs. See you next round."
# Existing Gramps-owned status message only; never creates a message automatically.
# SERVER_COMMUNITY_DISCORD_CHANNEL_ID=your_discord_channel_id
# SERVER_COMMUNITY_DISCORD_MESSAGE_ID=your_gramps_message_id
