# Copy this file to `.env` and fill in the required values.

# These are your environment variables used to configure your application.
# On Railway, .env files are not used. Instead, you should set these variables in the Railway dashboard, under the "Variables" tab of your project.
# DO NOT commit your `.env` file to version control (git). Don't worry, this template is already set up to ignore it.
# This template validates the environment variables at startup. So if you misconfigure something, the bot will not start and an error will be shown in the logs.

### == Required == ###

DISCORD_BOT_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxx.xxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxx-xx"
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

### == Optional == ###
# You may need to uncomment some of these variables depending on your use case. You may also comment the ones you don't need.

# One of "development", "production" or "staging". If this is running on your local machine, you should set this to "development". Otherwise, set it to "production" or "staging" depending on your environment.
# Default: If not set, it will be "development" if NODE_ENV is "development", otherwise "production".
NEST_ENV="development"

# The port the application will run on.
PORT="3000"

# Optional Gramps staff dashboard. The September 30 production migration is applied;
# keep disabled until the remaining OAuth and public/game connection checks pass.
ADMIN_ENABLED=false
# ADMIN_ORIGIN=https://admin.theuncsgaming.com
# ADMIN_DISCORD_CLIENT_ID=your_discord_application_id
# ADMIN_DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
# ADMIN_SESSION_SECRET=generate_a_random_secret_of_at_least_32_characters
# ADMIN_GUILD_ID=82988952587337728
# ADMIN_OWNER_IDS=comma_separated_discord_user_ids
# ADMIN_ADMIN_ROLE_IDS=comma_separated_discord_role_ids
# ADMIN_MODERATOR_ROLE_IDS=comma_separated_discord_role_ids
# ADMIN_VIEWER_ROLE_IDS=comma_separated_discord_role_ids
# WARDOGS_RCON_URL=https://your_rcon_endpoint
# WARDOGS_RCON_PASSWORD=your_rcon_password
# Optional public Wardogs Join by ID code, verified against Server settings → Identity.
# WARDOGS_SERVER_JOIN_ID=00000000-0000-4000-8000-000000000001

# Optional multi-server registry. Omit for the existing single server (ID primary).
# Requires the combined reviewed schema migration before deployment. Preserve the
# original server as primary; IDs are permanent data identities, never reusable labels.
# With a registry, staff must select an exact server; legacy game API routes refuse it.
# WARDOGS_FEED_TOKEN is then ignored: move it into primary's feedToken.
# WARDOGS_SERVERS=[{"id":"primary","name":"UNCs Main","rconUrl":"https://main.example.test","password":"replace-in-secret-store"},{"id":"events","name":"UNCs Events","rconUrl":"https://events.example.test","password":"replace-in-secret-store"}]
# Each entry may add a unique feedToken (32+ characters, never a game password),
# joinId:"00000000-0000-4000-8000-000000000001" (that server's public game join code),
# communityStatus:{"channelId":"DISCORD_ID","messageId":"DISCORD_ID"}, and
# staffRoles:{"admin":[],"moderator":[],"viewer":[]} using Discord role IDs.
# Absent staffRoles inherits community staff access. Present empty lists deny
# non-owners; restrictions may narrow access but never elevate a community role.
# Feed endpoint: /api/ingest/servers/SERVER_ID/events, or the game's fixed
# /api/ingest/events, which goes to the entry whose feedToken it carries.
# Status cards must be distinct.

# Website whitelist requests. Requires the reviewed application
# schema migration and Discord callback: APPLICATION_ORIGIN/apply/auth/callback.
# Shares Discord credentials above, but does not require ADMIN_ENABLED or RCON.
# Email is private application/access contact only, not a newsletter opt-in.
WHITELIST_APPLICATIONS_ENABLED=false
# APPLICATION_ORIGIN=https://theuncsgaming.com
WHITELIST_APPLICATION_EMAIL_REQUIRED=true
# Refuse approving a SteamID that is already whitelisted until staff confirm ownership
# (existingAccessConfirmed). Keep false until the dashboard sends that confirmation.
WHITELIST_APPLICATION_EXISTING_CONFIRMATION_REQUIRED=false

# As discord caches application commands for up to an hour, it is recommended to specify a development guild when doing development. If you have multiple, separate them with commas (",").
# DO NOT SET THIS TO YOUR DEPLOYED PRODUCTION BOT!
# DISCORD_DEVELOPMENT_GUILD_ID=""

# Combat history and public leaderboard (requires reviewed schema and host feed integration).
WARDOGS_FEED_ENABLED=false
# Single-server only; ignored once WARDOGS_SERVERS is set (use each entry's feedToken).
# WARDOGS_FEED_TOKEN=<separate-random-feed-only-secret-at-least-32-characters>

# Optional weekly Discord leaderboard post, one per configured server. See docs/guides/WEEKLY_LEADERBOARD.md.
# Off by default; also gates the staff post-now (preview always works). Silent without enough data.
# Use a text or announcement channel in ADMIN_GUILD_ID with View Channel, Send Messages and Read Message History.
# Day and time are New York wall-clock time (America/New_York, not configurable); 01:00-02:59 is refused.
WEEKLY_LEADERBOARD_ENABLED=false
# WEEKLY_LEADERBOARD_CHANNEL_ID=your_discord_leaderboard_channel_id
WEEKLY_LEADERBOARD_DAY=sunday
WEEKLY_LEADERBOARD_TIME=20:00
# Minimum kills (1-100000) and players (5-1000) in the week before anything is posted.
WEEKLY_LEADERBOARD_MIN_KILLS=100
WEEKLY_LEADERBOARD_MIN_PLAYERS=10

# Optional opt-in Seeder role and staff-triggered seeding pings. See docs/guides/SEEDING.md.
# Off by default. Members add or remove the role with /seeding join and /seeding leave, or the panel
# buttons staff post with /seeding panel. Pings never go out automatically: staff send /seeding ping by hand.
# Every seeding setting needs ADMIN_GUILD_ID. No schema change; the role itself is the opt-in list.
SEEDING_ENABLED=false
# A plain role in ADMIN_GUILD_ID with no permissions, placed below Gramps. Leave "Allow anyone to
# @mention this role" off so only staff pings reach it.
# SEEDING_ROLE_ID=your_discord_seeder_role_id
# Text or announcement channel in ADMIN_GUILD_ID. Gramps needs View Channel, Send Messages and, unless
# the role is mentionable, Mention @everyone, @here and All Roles there; the ping still mentions only Seeder.
# SEEDING_PING_CHANNEL_ID=your_discord_seeding_channel_id
# Minutes between staff pings (15-1440), per Discord server, kept in memory: a restart resets it.
SEEDING_PING_COOLDOWN_MINUTES=120

# Patreon supporter tracking. Enable only after the reviewed schema. See docs/guides/PATREON_SUPPORTERS.md.
PATREON_ENABLED=false
# PATREON_CAMPAIGN_ID=<your-numeric-creator-campaign-id>
# Recommended: read-only import of existing and future members from the Patreon API v2.
# Copy the Creator's Access Token from https://www.patreon.com/portal/registration/register-clients.
# Never logged or returned. Not refreshed automatically: when the Supporters page reports the token
# was rejected, renew it on the client page and update this value. Must differ from every other secret.
# PATREON_CREATOR_ACCESS_TOKEN=<creators-access-token>
# Import runs ~15 seconds after startup, then every N minutes (10-1440).
PATREON_SYNC_INTERVAL_MINUTES=30
# Optional webhooks. Use the secret provided by Patreon for this webhook, never a bot/RCON/session secret.
# Endpoint: https://YOUR-GRAMPS-ORIGIN/supporters/webhooks/patreon
# PATREON_WEBHOOK_SECRET=<Patreon-webhook-signing-secret>
# Optional "Link Patreon": patrons run /patreon link in Discord, sign in to Discord and Patreon, and Gramps
# links their membership to that Discord account. Needs the import above, ADMIN_ORIGIN with the dashboard's
# Discord sign-in settings, DISCORD_ROLES_ENABLED and DISCORD_SUPPORTER_ROLE_ID. Redirect URIs to add:
# Patreon client: https://YOUR-ADMIN-ORIGIN/supporters/link/patreon/callback
# Discord application: https://YOUR-ADMIN-ORIGIN/supporters/link/discord/callback
PATREON_LINK_ENABLED=false
# Client ID and secret of the Patreon client behind the creator token. The secret must differ from every
# other secret. It is sent only to Patreon and never logged.
# PATREON_CLIENT_ID=<patreon-client-id>
# PATREON_CLIENT_SECRET=<patreon-client-secret>
# Approved founder campaign: Sep 30 through Oct 14, 2026, Eastern time. The end is exclusive and the
# window must be exactly 15 days, so never use 23:59:59 on Oct 14.
# Founder eligibility (Patreon or PayPal): a verified first payment of at least US$5 in that window.
PATREON_FOUNDER_START_AT=2026-09-30T00:00:00-04:00
PATREON_FOUNDER_END_AT=2026-10-15T00:00:00-04:00
# Optional provider-neutral alias. A complete pair wins; if both pairs are set they must match.
# SUPPORTER_FOUNDER_START_AT=2026-09-30T00:00:00-04:00
# SUPPORTER_FOUNDER_END_AT=2026-10-15T00:00:00-04:00

# Optional automatic Discord roles in ADMIN_GUILD_ID (see docs/guides/DISCORD_ROLES.md).
# UNC: approved unc_member applications. Founder: founder records with a linked Discord account
# (staff link, PayPal record, the Discord account a patron connected on Patreon, or Link Patreon).
# Supporter (optional): people with a linked Discord account who support right now (active Patreon
# membership, 7 days after a declined charge, or 31 days after a PayPal payment). Discord role only.
# The bot role needs Manage Roles and must sit above every configured role. Keep false until the status
# page reports ready and a dry run looks right; the first start after enabling performs the backfill.
DISCORD_ROLES_ENABLED=false
# DISCORD_MEMBER_ROLE_ID=your_unc_role_id
# DISCORD_FOUNDER_ROLE_ID=your_founder_role_id
# DISCORD_SUPPORTER_ROLE_ID=your_supporter_role_id

# Optional single-instance Gramps community worker. Keep disabled for deployment
# until the reviewed admin schema exists and overlapping old announcements stop.
# Round messages follow an observed transition, not an authoritative match-end event.
SERVER_COMMUNITY_ENABLED=false
SERVER_COMMUNITY_WELCOME_ENABLED=false
SERVER_COMMUNITY_ROUND_ENABLED=false
SERVER_COMMUNITY_DISCORD_STATUS_ENABLED=false
SERVER_COMMUNITY_WELCOME_MESSAGE="Welcome to The UNCs! Squad up and enjoy the server."
# Optional JSON array of 1-4 short messages replaces WELCOME_MESSAGE. Keep each under 201 characters.
# Approved UNCs wording; verify the website is available before using it on another deployment.
# SERVER_COMMUNITY_WELCOME_MESSAGES='["Welcome to The UNCs! Website: theuncsgaming.com","Get whitelisted: theuncsgaming.com/whitelist. Sign in with Discord and apply on the website."]'
# Optional JSON array of 1-20 variants, each a 1-4 message sequence like WELCOME_MESSAGES; replaces both
# settings above. Each observed join gets one variant at random, never the one that player got last time
# and, with 3+ variants, never the previous joiner's. Ready-now UNCs copy from docs/guides/SERVER_COMMUNITY.md; its
# queue-priority set is only for a server whose reserved slots are verified to get whitelisted players past the queue:
# SERVER_COMMUNITY_WELCOME_VARIANTS='[["Welcome to The UNCs. Good games, older knees.","Get whitelisted: theuncsgaming.com/whitelist"],["Aged a little while you waited? Welcome to The UNCs.","Apply for the whitelist: theuncsgaming.com/whitelist"],["You made it. The UNCs salute your patience and your lower back.","Sign in with Discord and apply: theuncsgaming.com/whitelist"],["Welcome to The UNCs. Grab a squad, take the hill, mind your knees.","Discord and whitelist: theuncsgaming.com"],["Reading glasses on, soldier. The hill will not hold itself.","Welcome to The UNCs: theuncsgaming.com"],["Welcome in. Fast trigger fingers, earned naps.","Join the crew: theuncsgaming.com/whitelist"],["Long queue? We noticed. Welcome to The UNCs.","Thanks for your patience. Website: theuncsgaming.com"],["Welcome to The UNCs. Hydrate, squad up, use comms.","Find the crew at theuncsgaming.com"]]'
# Optional variants in the same shape for joiners already on that server's running whitelist (reserved slots).
# Unset, or while the whitelist cannot be read, everyone gets the welcome above. Recommended UNCs copy:
# SERVER_COMMUNITY_WHITELISTED_WELCOME_VARIANTS='[["Welcome back, unc. Knees warmed up?","The crew missed you. Your knees did not."],["Look who is back. Grab a squad and take the hill.","Go show the rookies how it is done."],["Welcome back. Hydrate, use comms, play the objective.","Thanks for being part of the crew. Your knees are proud of you."],["The UNCs salute you. Reading glasses on, soldier.","Server quiet? Bring a friend and help seed."]]'
SERVER_COMMUNITY_WELCOME_DELAY_SECONDS=10
SERVER_COMMUNITY_WELCOME_SPACING_SECONDS=20
SERVER_COMMUNITY_ROUND_MESSAGE="GG! Thanks for playing on The UNCs. See you next round."
# Optional JSON array of 1-20 round messages replaces ROUND_MESSAGE. Each round gets one at random,
# never the previous round's. Ready-now UNCs copy (see the guide for the queue-priority set):
# SERVER_COMMUNITY_ROUND_MESSAGES='["GG! Get whitelisted at theuncsgaming.com/whitelist. Thanks for playing on The UNCs.","GG, all. Stretch, hydrate, run it back. theuncsgaming.com","GG! Good games, older knees. Join the crew: theuncsgaming.com","GG! More games, more crew: theuncsgaming.com/whitelist","GG. Thanks for playing on The UNCs. Discord and whitelist: theuncsgaming.com"]'
# Existing Gramps-owned status message only; never creates a message automatically.
# SERVER_COMMUNITY_DISCORD_CHANNEL_ID=your_discord_channel_id
# SERVER_COMMUNITY_DISCORD_MESSAGE_ID=your_gramps_message_id

# Optional Discord map voting. Requires the reviewed voting-controls migration before enabling.
# See docs/guides/SERVER_COMMUNITY.md for setup, safeguards and runtime limitations.
# Use a text channel in ADMIN_GUILD_ID with View Channel, Send Messages and Read Message History.
MAP_VOTES_ENABLED=false
# MAP_VOTES_CHANNEL_ID=your_discord_voting_channel_id
# Automatic voting and its two reminders are switched on per server in the dashboard (all off by default).
# Its Ballot settings save options per ballot, minimum players, opening delay and score limit, the close and
# reminder scores and the in-game open/result announcements; other ballot settings keep their saved values or defaults.
# The administrator saving the controls must retain access to that server.
# MAP_VOTES_AUTOMATIC is obsolete; remove old recipes and close existing timed ballots before cutover.
# Ballots and 50v50 rounds that need a person alert staff in STAFF_ALERTS_CHANNEL_ID (see Staff alerts below).
# Owner only: voted "50v50 next round" is held for the owner's in-person review. Keep false until then;
# SERVER_EVENTS_ENABLED alone never puts 50v50 on a ballot.
MAP_VOTES_FIFTY_ENABLED=false

# Staff alerts: alert-only. Gramps never kicks, bans or edits the whitelist on its own.
# See docs/guides/STAFF_ALERTS.md. State is in memory; run one replica.
# Private staff text channel in ADMIN_GUILD_ID (not a vote, community, weekly leaderboard or status channel), with
# @everyone denied View Channel and the bot allowed View Channel, Send Messages, Embed Links and
# Read Message History. Without it, alerts are only recorded for the staff status API (automation alerts are
# also logged). Map-vote and 50v50 automation alerts need only this channel, not STAFF_ALERTS_ENABLED.
# STAFF_ALERTS_CHANNEL_ID=your_staff_alerts_channel_id
STAFF_ALERTS_ENABLED=false
# Optional role pinged for high-severity alerts only (never @everyone). Discord notifies it only when the
# role allows anyone to @mention it, or Gramps has Mention @everyone, @here, and All Roles on the channel.
# STAFF_ALERTS_PING_ROLE_ID=your_staff_role_id
STAFF_ALERTS_TIME_ZONE=America/New_York

STAFF_ALERTS_HEALTH_ENABLED=false
STAFF_ALERTS_HEALTH_DOWN_MINUTES=10
STAFF_ALERTS_HEALTH_RESTART_PLAYERS=10
# Local HH:MM list; restarts within 20 minutes are labelled scheduled.
# STAFF_ALERTS_HEALTH_SCHEDULED_RESTARTS=04:00

STAFF_ALERTS_SEEDING_ENABLED=false
STAFF_ALERTS_SEEDING_BELOW=1
STAFF_ALERTS_SEEDING_MINUTES=30
STAFF_ALERTS_SEEDING_AFTER_RESTART_HOURS=12
STAFF_ALERTS_SEEDING_PRIME_HOURS=17:00-23:00

# false | observe (dashboard only, no Discord) | true
STAFF_ALERTS_PERFORMANCE_ENABLED=false
STAFF_ALERTS_PERFORMANCE_WINDOW_MINUTES=5
STAFF_ALERTS_PERFORMANCE_WINDOW_KILLS=30
STAFF_ALERTS_PERFORMANCE_MATCH_KILLS=40
STAFF_ALERTS_PERFORMANCE_MATCH_KD=20
STAFF_ALERTS_PERFORMANCE_PLAYER_COOLDOWN_MINUTES=360
STAFF_ALERTS_PERFORMANCE_MAX_PER_HOUR=3
STAFF_ALERTS_PERFORMANCE_SKIP_WHITELISTED=false
# Never flagged. SteamID64 strings or {"steamId","note"} objects.
# At most 500 entries and 65,536 characters (500 entries with 80-character notes fit).
# STAFF_ALERTS_PERFORMANCE_KNOWN_GOOD='[{"steamId":"7656119xxxxxxxxxx","note":"owner"}]'

STAFF_ALERTS_WATCHLIST_ENABLED=false
STAFF_ALERTS_WATCHLIST_HIGHLIGHT_COMMUNITIES=3
STAFF_ALERTS_WATCHLIST_COOLDOWN_MINUTES=360
# Copied by staff from WarDogs network alerts. Monitoring only.
# At most 200 entries and 65,536 characters, about 325 per entry when the list is full.
# STAFF_ALERTS_WATCHLIST='[{"steamId":"7656119xxxxxxxxxx","reason":"Aimbot","evidenceUrl":"https://example.com/clip","communities":4,"recordedAt":"2026-10-02","addedBy":"Dennis"}]'

# Optional supervised 50v50. Confirm the existing 0003 migration is applied
# and complete a controlled event test before enabling.
# Does not use Discord voice membership. No event starts merely by enabling the feature.
# Also required for automatic ballots to offer "50v50 next round", with the owner-only MAP_VOTES_FIFTY_ENABLED above.
SERVER_EVENTS_ENABLED=false
